{
	"tags":
	{
		"allowUnknownTags" : true
	},
	"plugins":[
		 "plugins/markdown",
		"./node_modules/tsdoc/template/plugins/TSDoc.js"
	],
	"opts":
	{
		"template"	:"./node_modules/tsdoc/template",
		"recurse"	:"true"
	},
	"templates" : {
		"cleverLinks"     : false,
		"monospaceLinks"  : false
	},
	"source":
	{
		"includePattern": "(\\.d)?\\.ts$"
	},
	"markdown"  : {
		"parser"   : "gfm",
		"hardwrap" : true
	},
	"tsdoc":{
		"source"		:"./ts/",
		"destination"	:"./docs/",
		"tutorials"		:"",
		"systemName"	: "zrup",
		"footer"		: "",
		"copyright"		: "zrup Copyright © 2021 rulatir.",
		"outputSourceFiles" : true,
		"commentsOnly": true
	}
}
